# Copy this file to backend/.env (or export these vars) to configure the app.

# true = use simulated model responses (no API keys needed, runs fully offline)
# false = call real OpenAI/Anthropic APIs for models it recognizes
MOCK_MODE=true

# Database (SQLite by default, swap for Postgres in production)
DATABASE_URL=sqlite:///./arena.db

# Only needed when MOCK_MODE=false
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
